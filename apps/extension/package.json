{
  "name": "@acme/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "rm -rf dist .wxt",
    "dev": "wxt",
    "predev:firefox": "rm -rf dist .wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:prod": "pnpm with-env-prod wxt build",
    "build:prod:firefox": "pnpm with-env-prod wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:prod": "pnpm with-env-prod wxt zip",
    "zip:prod:firefox": "pnpm with-env-prod wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "clean": "git clean -xdf .cache .turbo dist .wxt node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wxt prepare && tsc --noEmit",
    "with-env-prod": "dotenv -e ../../.env.prod --"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/auth-client": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:^",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "catalog:",
    "jsdom": "^29.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  },
  "prettier": "@acme/prettier-config"
}
